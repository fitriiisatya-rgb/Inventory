# Photo evidence storage — no direct HTTP access at all (design review
# point 20). The only sanctioned path to a photo is api/photos/view.php,
# which does a permission check by database id before streaming the file.
# This also means the random-UUID filename scheme doesn't need to carry
# the whole security burden by itself.

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Belt-and-braces even if the above is ever bypassed by a misconfigured
# vhost: never execute anything in here as a script, and never list the
# directory.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php|php[0-9]|phtml|pl|py|cgi|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
Options -Indexes -ExecCGI
