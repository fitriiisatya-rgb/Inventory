# Copy to .env and fill in per-environment values. Never commit the real .env.
# This app reads ONLY environment variables — no domain or credential is
# ever hardcoded in source, so the same codebase serves the old and the new
# domain/database side-by-side without code changes.

APP_ENV=production
APP_DEBUG=false
# Full origin of the NEW deployment, e.g. https://inventory2.domain.com
# Used only for CORS allow-list and cookie domain scoping — the frontend
# itself always calls the API via the relative path /api/... .
APP_URL=https://CHANGE-ME.example.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inventory_mysql
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_CHARSET=utf8mb4

SESSION_COOKIE_NAME=inv_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Strict
SESSION_LIFETIME_MINUTES=480

# Comma-separated list of origins allowed to call this API. Leave empty
# (same-origin only, no CORS headers sent) unless the frontend is genuinely
# hosted on a different origin from the API.
CORS_ALLOWED_ORIGINS=

PRICE_ANOMALY_HIGH_MULTIPLIER=5
PRICE_ANOMALY_LOW_MULTIPLIER=0.2
ALLOW_NEGATIVE_STOCK_DEFAULT=false

LOG_PATH=storage/logs/app.log
